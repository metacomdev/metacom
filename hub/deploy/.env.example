# Domain that points at this server; Caddy fetches its certificate automatically.
HUB_DOMAIN=hub.example.com

# Where people reach the hub (shown in the chat's room list; the base of one-tap answer links).
# HUB_PUBLIC_URL=https://hub.example.com

# Phone alerts through ntfy, besides web push: a topic URL nobody can guess (and a token if the
# ntfy server needs one). Alerts carry the agent's question; keep the topic private.
# HUB_NTFY_URL=https://ntfy.sh/metacom-<random>
# HUB_NTFY_TOKEN=
